# ── Microservicio Resume Go ─────────────────────────────────────────────────────
APP_NAME=microservicio-resume
APP_VERSION=0.1.0
LOG_LEVEL=INFO
PORT=8080
TZ=America/Argentina/Mendoza

# ── Red compartida entre todos los Compose ──────────────────────────────────────
SHARED_NETWORK_NAME=test_network

# ── Kafka ──
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_VALIDATED=pdf.validated
KAFKA_TOPIC_COMPLETED=summary.completed
KAFKA_TOPIC_DLQ=summary.dlq
KAFKA_CONSUMER_GROUP=resume-worker
KAFKA_CLIENT_ID=microservicio-resume

# ── IA (proveedor OpenAI-compatible) ──
AI_API_KEY=sk-tu-clave-aqui
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3
AI_TIMEOUT=30s
AI_MAX_RETRIES=3
AI_BACKOFF_BASE=1s

# ── PDF ──
MAX_PAGES=10

# ── Persistencia (vía HTTP al microservicio-db-go) ──
DB_SERVICE_URL=http://microservicio-db-go:8080
DB_SERVICE_TIMEOUT=10s
# API key opcional para autenticación Bearer contra db-go (dejar vacío si no se usa)
DB_API_KEY=
# El evento se publica antes de persistir: espera acotada a que el documento exista
DB_WAIT_TIMEOUT=2m
DB_WAIT_INTERVAL=1s

# ── RFC 9457 ──
ERR_BASE_URL=https://errors.example.com